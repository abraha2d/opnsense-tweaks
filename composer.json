{
    "name": "abraha2d/opnsense-tweaks",
    "description": "DHCP + CARP HA for OPNsense — test harness",
    "type": "project",
    "require": {
        "php": "^8.5"
    },
    "require-dev": {
        "pestphp/pest": "^5.1",
        "phpunit/phpcov": "^13.1",
        "laravel/pint": "^1.24",
        "phpstan/phpstan": "^2.2"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest --colors=always",
        "test:coverage": "pest --coverage",
        "lint": "pint --test src",
        "format": "pint src",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
